# Copy to /etc/aqmonitor/aqmonitor.env, then:  chmod 600 /etc/aqmonitor/aqmonitor.env
# (readable by root only; systemd injects it into the service, the service user never reads the file)

# Required. Request a free API token from the WAQI project (aqicn.org, "API" section).
WAQI_TOKEN=

# Default is loopback only. To serve your LAN, bind the Pi's LAN address (not 0.0.0.0):
#BIND_ADDR=192.168.1.50:8080

# Seconds a reading is cached (30..86400). Fewer upstream calls = less quota used.
#CACHE_TTL_SECS=600

# Log level: error | warn | info | debug
#RUST_LOG=info
